@model QLBH.Models.CTMH

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>CTMH</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            @if (ViewBag.LoiTao != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.LoiTao
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="MaDMH" class="control-label">
                    Đơn mua hàng
                </label>

                <select asp-for="MaDMH"
                        asp-items="ViewBag.MaDMH"
                        class="form-control">
                    <option value="">-- Chọn đơn mua hàng --</option>
                </select>

                <span asp-validation-for="MaDMH" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaSP" class="control-label">
                    Sản phẩm
                </label>

                <select asp-for="MaSP"
                        asp-items="ViewBag.MaSP"
                        class="form-control">
                    <option value="">-- Chọn sản phẩm --</option>
                </select>

                <span asp-validation-for="MaSP" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Số lượng mua</label>
                <input asp-for="SLM" class="form-control" />
                <span asp-validation-for="SLM" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Đơn giá mua</label>
                <input asp-for="DGM" class="form-control" />
                <span asp-validation-for="DGM" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
