@model QLBH.Models.CTMH

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>CTMH</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaDMH" />
            <input type="hidden" asp-for="MaSP" />
            <div class="form-group">
                <label>Mã đơn mua hàng</label>
                <p class="form-control-plaintext">@Model.MaDMH</p>
            </div>
            <div class="form-group">
                <label>Tên sản phẩm</label>
                <p class="form-control-plaintext">@(ViewBag.TenSP[Model.MaSP])</p>
            </div>
            <div class="form-group">
                <label>Số lượng mua</label>
                <input asp-for="SLM" class="form-control" />
                <span asp-validation-for="SLM" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Đơn giá mua</label>
                <input asp-for="DGM" class="form-control" />
                <span asp-validation-for="DGM" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
