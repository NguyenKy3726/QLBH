@using Microsoft.AspNetCore.Http
@inject QLBH.Data.AppDbContext AppDb
@{
    var role = Context.Session.GetString("Role");
    var displayName = Context.Session.GetString("DisplayName") ?? Context.Session.GetString("Username") ?? "";
    var avatarPath = Context.Session.GetString("AvatarPath");
    var isCustomer = role == "KhachHang";
    var isEmployee = role == "NhanVien";
    var hasAdmin = Context.Session.GetString("Permission:ADMIN") == "1";
    var employeeId = Context.Session.GetInt32("MaNV");
    var visibleTables = isEmployee && !hasAdmin && employeeId is >= 0 and <= 255
        ? AppDb.NhanVien_BangDuocXem((byte)employeeId.Value)
        : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Whiskful</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QLBH.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body id="top" class="app-shell">
    <header class="site-header">
        <nav class="navbar navbar-expand-xl" aria-label="Điều hướng chính">
            <div class="container site-header__inner">
                <a class="navbar-brand site-brand" asp-controller="Home" asp-action="Index" aria-label="Whiskful - Trang chủ">
                    <img src="~/assets/images/logo/whiskful-logo.webp" alt="Whiskful" />
                </a>
                <button class="navbar-toggler site-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav site-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(controller == "Home" && action == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "SanPhams" ? "active" : "")" asp-controller="SanPhams" asp-action="Index">Sản phẩm</a></li>
                        @if (isCustomer)
                        {
                            <li class="nav-item"><a class="nav-link @(controller == "GioHang" && action == "Index" ? "active" : "")" asp-controller="GioHang" asp-action="Index">Giỏ hàng</a></li>
                            <li class="nav-item"><a class="nav-link @(controller == "GioHang" && action == "DonCuaToi" ? "active" : "")" asp-controller="GioHang" asp-action="DonCuaToi">Đơn hàng của tôi</a></li>
                        }
                        @if (isEmployee && (hasAdmin || visibleTables.Count > 0))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "QuanLy" ? "active" : "")" asp-controller="QuanLy" asp-action="Index">Quản lý</a>
                            </li>
                        }
                    </ul>
                    <div class="site-header__actions">
                        @if (role == null)
                        {
                            <a class="site-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="btn site-button site-button--dark" asp-controller="SanPhams" asp-action="Index">Khám phá gạo</a>
                        }
                        else
                        {
                            <a class="site-user site-link" asp-controller="Account" asp-action="ThongTin" title="Thông tin tài khoản"
                               aria-current="@(controller == "Account" && action == "ThongTin" ? "page" : null)">
                                @if (!string.IsNullOrWhiteSpace(avatarPath))
                                {
                                    <img class="site-user__avatar" src="@Url.Content(avatarPath)" alt="" />
                                }
                                @displayName
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button class="site-link site-link--button" type="submit">Đăng xuất</button>
                            </form>
                            @if (isCustomer)
                            {
                                <a class="btn site-button site-button--dark" asp-controller="GioHang" asp-action="Index">Giỏ hàng</a>
                            }
                            else if (isEmployee)
                            {
                                <span class="site-role">@(hasAdmin ? "Quản trị viên" : "Nhân viên")</span>
                            }
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main">
        <div class="container site-main__container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container site-footer__main">
            <div>
                <a asp-controller="Home" asp-action="Index" class="site-footer__brand">Whiskful</a>
                <p>Gạo ngon cho bữa cơm ấm áp mỗi ngày.</p>
            </div>
            <div class="site-footer__links">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="SanPhams" asp-action="Index">Sản phẩm</a>
                @if (isCustomer)
                {
                    <a asp-controller="GioHang" asp-action="DonCuaToi">Đơn hàng của tôi</a>
                }
            </div>
            <p class="site-footer__copyright">© 2026 Whiskful. Bảo lưu mọi quyền.</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
