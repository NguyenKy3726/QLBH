@using Microsoft.AspNetCore.Http
@inject QLBH.Data.AppDbContext AppDb
@{
    var role = Context.Session.GetString("Role");
    var displayName = Context.Session.GetString("DisplayName") ?? Context.Session.GetString("Username") ?? "";
    var isCustomer = role == "KhachHang";
    var isEmployee = role == "NhanVien";
    var hasAdmin = Context.Session.GetString("Permission:ADMIN") == "1";
    var hasSales = Context.Session.GetString("Permission:SALES") == "1";
    var hasWarehouse = Context.Session.GetString("Permission:WAREHOUSE") == "1";
    var employeeId = Context.Session.GetInt32("MaNV");
    var visibleTables = isEmployee && !hasAdmin && employeeId is >= 0 and <= 255
        ? AppDb.NhanVien_BangDuocXem((byte)employeeId.Value)
        : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    bool CanRead(string tableName) => hasAdmin || visibleTables.Contains(tableName);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Whiskful</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QLBH.styles.css" asp-append-version="true" />
</head>
<body id="top" class="app-shell">
    <header class="site-header">
        <nav class="navbar navbar-expand-xl" aria-label="Điều hướng chính">
            <div class="container site-header__inner">
                <a class="navbar-brand site-brand" asp-controller="Home" asp-action="Index" aria-label="Whiskful - Trang chủ">
                    <img src="~/assets/images/logo/whiskful-logo.webp" alt="Whiskful" />
                </a>
                <button class="navbar-toggler site-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav site-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(controller == "Home" && action == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "SanPhams" ? "active" : "")" asp-controller="SanPhams" asp-action="Index">Sản phẩm</a></li>
                        @if (isCustomer)
                        {
                            <li class="nav-item"><a class="nav-link @(controller == "GioHang" && action == "Index" ? "active" : "")" asp-controller="GioHang" asp-action="Index">Giỏ hàng</a></li>
                            <li class="nav-item"><a class="nav-link @(controller == "GioHang" && action == "DonCuaToi" ? "active" : "")" asp-controller="GioHang" asp-action="DonCuaToi">Đơn hàng của tôi</a></li>
                        }
                        @if (isEmployee && (hasAdmin || ((hasSales || hasWarehouse) && visibleTables.Count > 0)))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(controller != "Home" && controller != "SanPhams" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Quản lý</a>
                                <ul class="dropdown-menu site-menu">
                                    @if (hasAdmin)
                                    {
                                        <li><h2 class="dropdown-header">Danh mục & hệ thống</h2></li>
                                        <li><a class="dropdown-item" asp-controller="DonViTinhs" asp-action="Index">Đơn vị tính</a></li>
                                        <li><a class="dropdown-item" asp-controller="NhomSPs" asp-action="Index">Nhóm sản phẩm</a></li>
                                        <li><a class="dropdown-item" asp-controller="LoaiSPs" asp-action="Index">Loại sản phẩm</a></li>
                                        <li><a class="dropdown-item" asp-controller="SanPhams" asp-action="Index">Sản phẩm</a></li>
                                        <li><a class="dropdown-item" asp-controller="Tinhs" asp-action="Index">Tỉnh</a></li>
                                        <li><a class="dropdown-item" asp-controller="XaPhuongs" asp-action="Index">Xã/phường</a></li>
                                        <li><a class="dropdown-item" asp-controller="PhongBans" asp-action="Index">Phòng ban</a></li>
                                        <li><a class="dropdown-item" asp-controller="NhanViens" asp-action="Index">Nhân viên</a></li>
                                        <li><a class="dropdown-item" asp-controller="Quyens" asp-action="Index">Quyền</a></li>
                                        <li><a class="dropdown-item" asp-controller="PhanQuyens" asp-action="Index">Phân quyền</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><h2 class="dropdown-header">Nghiệp vụ bán hàng</h2></li>
                                        <li><a class="dropdown-item" asp-controller="NhaCCs" asp-action="Index">Nhà cung cấp</a></li>
                                        <li><a class="dropdown-item" asp-controller="DonMHs" asp-action="Index">Đơn mua hàng</a></li>
                                        <li><a class="dropdown-item" asp-controller="CTMHs" asp-action="Index">Chi tiết mua hàng</a></li>
                                        <li><a class="dropdown-item" asp-controller="KhachHangs" asp-action="Index">Khách hàng</a></li>
                                        <li><a class="dropdown-item" asp-controller="DonBHs" asp-action="Index">Đơn bán hàng</a></li>
                                        <li><a class="dropdown-item" asp-controller="CTBHs" asp-action="Index">Chi tiết bán hàng</a></li>
                                    }
                                    else
                                    {
                                        @if (visibleTables.Count > 0)
                                        {
                                            @if (CanRead("DonViTinh") || CanRead("NhomSP") || CanRead("LoaiSP") || CanRead("SanPham") || CanRead("Tinh") || CanRead("XaPhuong"))
                                            { <li><h2 class="dropdown-header">Danh mục</h2></li> }
                                            @if (CanRead("DonViTinh")) { <li><a class="dropdown-item" asp-controller="DonViTinhs" asp-action="Index">Đơn vị tính</a></li> }
                                            @if (CanRead("NhomSP")) { <li><a class="dropdown-item" asp-controller="NhomSPs" asp-action="Index">Nhóm sản phẩm</a></li> }
                                            @if (CanRead("LoaiSP")) { <li><a class="dropdown-item" asp-controller="LoaiSPs" asp-action="Index">Loại sản phẩm</a></li> }
                                            @if (CanRead("SanPham")) { <li><a class="dropdown-item" asp-controller="SanPhams" asp-action="Index">Sản phẩm</a></li> }
                                            @if (CanRead("Tinh")) { <li><a class="dropdown-item" asp-controller="Tinhs" asp-action="Index">Tỉnh</a></li> }
                                            @if (CanRead("XaPhuong")) { <li><a class="dropdown-item" asp-controller="XaPhuongs" asp-action="Index">Xã/phường</a></li> }
                                            @if (CanRead("KhachHang") || CanRead("DonBH") || CanRead("CTBH"))
                                            { <li><h2 class="dropdown-header">Bán hàng</h2></li> }
                                            @if (CanRead("KhachHang")) { <li><a class="dropdown-item" asp-controller="KhachHangs" asp-action="Index">Khách hàng</a></li> }
                                            @if (CanRead("DonBH")) { <li><a class="dropdown-item" asp-controller="DonBHs" asp-action="Index">Đơn bán hàng</a></li> }
                                            @if (CanRead("CTBH")) { <li><a class="dropdown-item" asp-controller="CTBHs" asp-action="Index">Chi tiết bán hàng</a></li> }
                                            @if (CanRead("NhaCC") || CanRead("DonMH") || CanRead("CTMH"))
                                            { <li><h2 class="dropdown-header">Mua hàng</h2></li> }
                                            @if (CanRead("NhaCC")) { <li><a class="dropdown-item" asp-controller="NhaCCs" asp-action="Index">Nhà cung cấp</a></li> }
                                            @if (CanRead("DonMH")) { <li><a class="dropdown-item" asp-controller="DonMHs" asp-action="Index">Đơn mua hàng</a></li> }
                                            @if (CanRead("CTMH")) { <li><a class="dropdown-item" asp-controller="CTMHs" asp-action="Index">Chi tiết mua hàng</a></li> }
                                            @if (CanRead("PhongBan") || CanRead("NhanVien") || CanRead("Quyen") || CanRead("PhanQuyen"))
                                            { <li><h2 class="dropdown-header">Tài khoản & hệ thống</h2></li> }
                                            @if (CanRead("PhongBan")) { <li><a class="dropdown-item" asp-controller="PhongBans" asp-action="Index">Phòng ban</a></li> }
                                            @if (CanRead("NhanVien")) { <li><a class="dropdown-item" asp-controller="NhanViens" asp-action="Index">Nhân viên</a></li> }
                                            @if (CanRead("Quyen")) { <li><a class="dropdown-item" asp-controller="Quyens" asp-action="Index">Quyền</a></li> }
                                            @if (CanRead("PhanQuyen")) { <li><a class="dropdown-item" asp-controller="PhanQuyens" asp-action="Index">Phân quyền</a></li> }
                                        }
                                    }
                                </ul>
                            </li>
                        }
                    </ul>
                    <div class="site-header__actions">
                        @if (role == null)
                        {
                            <a class="site-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                            <a class="btn site-button site-button--dark" asp-controller="SanPhams" asp-action="Index">Khám phá gạo</a>
                        }
                        else
                        {
                            <span class="site-user">@displayName</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <button class="site-link site-link--button" type="submit">Đăng xuất</button>
                            </form>
                            @if (isCustomer)
                            {
                                <a class="btn site-button site-button--dark" asp-controller="GioHang" asp-action="Index">Giỏ hàng</a>
                            }
                            else if (isEmployee)
                            {
                                <span class="site-role">@(hasAdmin ? "Quản trị viên" : hasSales && hasWarehouse ? "Nhân viên" : hasSales ? "Sales" : hasWarehouse ? "Warehouse" : "Nhân viên")</span>
                            }
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="site-main">
        <div class="container site-main__container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container site-footer__main">
            <div>
                <a asp-controller="Home" asp-action="Index" class="site-footer__brand">Whiskful</a>
                <p>Gạo ngon cho bữa cơm ấm áp mỗi ngày.</p>
            </div>
            <div class="site-footer__links">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="SanPhams" asp-action="Index">Sản phẩm</a>
                @if (isCustomer)
                {
                    <a asp-controller="GioHang" asp-action="DonCuaToi">Đơn hàng của tôi</a>
                }
            </div>
            <p class="site-footer__copyright">© 2026 Whiskful. Bảo lưu mọi quyền.</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
