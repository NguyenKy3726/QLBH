@model QLBH.Models.DonBH

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>DonBH</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaDBH" />
            <div class="form-group">
                <label>Ngày đặt</label>
                <input asp-for="NgayDat" class="form-control" />
                <span asp-validation-for="NgayDat" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Ngày giao</label>
                <input asp-for="NgayGiao" class="form-control" />
                <span asp-validation-for="NgayGiao" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Địa chỉ giao hàng</label>
                <input asp-for="DCGH" class="form-control" />
                <span asp-validation-for="DCGH" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaXP" class="control-label">
                    Xã/phường
                </label>

                <select asp-for="MaXP"
                        asp-items="ViewBag.MaXP"
                        class="form-control">
                    <option value="">-- Chọn xã/phường --</option>
                </select>

                <span asp-validation-for="MaXP" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaNV" class="control-label">
                    Nhân viên
                </label>

                <select asp-for="MaNV"
                        asp-items="ViewBag.MaNV"
                        class="form-control">
                    <option value="">-- Chọn nhân viên --</option>
                </select>

                <span asp-validation-for="MaNV" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaKH" class="control-label">
                    Khách hàng
                </label>

                <select asp-for="MaKH"
                        asp-items="ViewBag.MaKH"
                        class="form-control">
                    <option value="">-- Chọn khách hàng --</option>
                </select>

                <span asp-validation-for="MaKH" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
