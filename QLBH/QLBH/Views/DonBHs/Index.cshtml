@model IEnumerable<QLBH.Models.DonBH>

@functions {
    private static string TrangThaiLabel(string? status) => status switch
    {
        "CHO_XAC_NHAN" => "Chờ xác nhận",
        "DA_XAC_NHAN" => "Đã xác nhận",
        "DANG_CHUAN_BI" => "Đang chuẩn bị",
        "DANG_GIAO" => "Đang giao",
        "HOAN_TAT" => "Hoàn tất",
        "DA_HUY" => "Đã hủy",
        _ => "Không xác định"
    };

    private static string TrangThaiCss(string? status) => status switch
    {
        "CHO_XAC_NHAN" => "bg-secondary",
        "DA_XAC_NHAN" => "bg-primary",
        "DANG_CHUAN_BI" => "bg-info text-dark",
        "DANG_GIAO" => "bg-warning text-dark",
        "HOAN_TAT" => "bg-success",
        "DA_HUY" => "bg-danger",
        _ => "bg-dark"
    };
}

@{
    ViewData["Title"] = "Đơn bán hàng";
}

<h1>Đơn bán hàng</h1>
@if (TempData["ThongBaoDonBH"] is string thongBao)
{
    <div class="alert alert-success">@thongBao</div>
}
@if (TempData["LoiDonBH"] is string loi)
{
    <div class="alert alert-danger">@loi</div>
}
<p><a asp-action="Create" class="btn btn-primary">create</a></p>

<div class="table-responsive crud-table-frame">
<table class="table align-middle">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Ngày đặt</th>
            <th>Ngày giao</th>
            <th>Địa chỉ giao hàng</th>
            <th>Xã/phường</th>
            <th>Nhân viên</th>
            <th>Khách hàng</th>
            <th>Trạng thái</th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.MaDBH</td>
            <td>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@(item.NgayGiao?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa giao")</td>
            <td>@item.DCGH</td>
            <td>@(ViewBag.TenXP[item.MaXP])</td>
            <td>
                @if (item.MaNV.HasValue)
                {
                    @($"{item.MaNV.Value} - {ViewBag.TenNV[item.MaNV.Value]}")
                }
                else
                {
                    @:Chưa tiếp nhận
                }
            </td>
            <td>@item.MaKH - @(ViewBag.TenKH[item.MaKH])</td>
            <td><span class="badge @TrangThaiCss(item.TrangThai)">@TrangThaiLabel(item.TrangThai)</span></td>
            <td class="text-nowrap crud-actions">
                <a asp-action="Details" asp-route-madbh="@item.MaDBH" class="crud-action crud-action--details" title="Details" aria-label="Details">Details</a>
                @if (item.TrangThai == "CHO_XAC_NHAN")
                {
                    
                    <a asp-action="Edit" asp-route-madbh="@item.MaDBH" class="crud-action crud-action--edit" title="Edit" aria-label="Edit">Edit</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
