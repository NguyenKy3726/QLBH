@model QLBH.Models.SanPham

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>SanPham</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label>Tên sản phẩm</label>
                <input asp-for="TenSP" class="form-control" />
                <span asp-validation-for="TenSP" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Đơn giá</label>
                <input asp-for="DonGia" class="form-control" />
                <span asp-validation-for="DonGia" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="fileAnh">Ảnh minh họa</label>
                <input type="file" id="fileAnh" name="fileAnh" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                <small class="form-text text-muted">Chọn ảnh JPG, PNG hoặc WEBP (tối đa 5 MB).</small>
                <span class="text-danger">@Html.ValidationMessage("fileAnh")</span>
                <img id="previewAnh" alt="Xem trước ảnh sản phẩm" style="display:none;max-width:220px;max-height:180px;margin-top:12px;border-radius:8px;object-fit:cover;" />
            </div>

            <div class="form-group">
                <label>Mô tả</label>
                <input asp-for="MoTaCT" class="form-control" />
                <span asp-validation-for="MoTaCT" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaLSP" class="control-label">
                    Loại sản phẩm
                </label>

                <select asp-for="MaLSP"
                        asp-items="ViewBag.MaLSP"
                        class="form-control">
                    <option value="">-- Chọn loại sản phẩm --</option>
                </select>

                <span asp-validation-for="MaLSP" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaDVT" class="control-label">
                    Đơn vị tính
                </label>

                <select asp-for="MaDVT"
                        asp-items="ViewBag.MaDVT"
                        class="form-control">
                    <option value="">-- Chọn đơn vị tính --</option>
                </select>

                <span asp-validation-for="MaDVT" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('fileAnh')?.addEventListener('change', function (event) {
        const file = event.target.files?.[0];
        const preview = document.getElementById('previewAnh');
        if (!file || !preview) {
            preview?.removeAttribute('src');
            if (preview) preview.style.display = 'none';
            return;
        }
        preview.src = URL.createObjectURL(file);
        preview.style.display = 'block';
    });
</script>

<div>
    <a asp-action="Index">Back to List</a>
</div>
