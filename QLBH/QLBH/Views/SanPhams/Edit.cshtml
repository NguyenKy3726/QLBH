@model QLBH.Models.SanPham

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>SanPham</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaSP" />
            <div class="form-group">
                <label>Mã sản phẩm</label>
                <p class="form-control-plaintext">@Model.MaSP</p>
            </div>
            <div class="form-group">
                <label>Tên sản phẩm</label>
                <input asp-for="TenSP" class="form-control" />
                <span asp-validation-for="TenSP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Đơn giá</label>
                <input asp-for="DonGia" class="form-control" />
                <span asp-validation-for="DonGia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Ảnh hiện tại</label>
                @if (!string.IsNullOrWhiteSpace(Model.AnhSP))
                {
                    var imageSource = Model.AnhSP.StartsWith("~/") || Model.AnhSP.StartsWith("/")
                        ? Url.Content(Model.AnhSP)
                        : Url.Action("SanPham", "Images", new { id = Model.MaSP });
                    <div><img src="@imageSource" alt="Ảnh @Model.TenSP" style="max-width:180px;max-height:140px;object-fit:contain" /></div>
                    <small>@Model.AnhSP</small>
                    <label class="form-check-label"><input type="checkbox" name="removeImage" value="true" /> Xóa ảnh hiện tại</label>
                }
                <label for="fileAnh">Chọn ảnh mới (JPG, PNG, WEBP; tối đa 5 MB)</label>
                <input type="file" id="fileAnh" name="fileAnh" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                @Html.ValidationMessage("fileAnh", "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label>Mô tả</label>
                <input asp-for="MoTaCT" class="form-control" />
                <span asp-validation-for="MoTaCT" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaLSP" class="control-label">
                    Loại sản phẩm
                </label>

                <select asp-for="MaLSP"
                        asp-items="ViewBag.MaLSP"
                        class="form-control">
                    <option value="">-- Chọn loại sản phẩm --</option>
                </select>

                <span asp-validation-for="MaLSP" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MaDVT" class="control-label">
                    Đơn vị tính
                </label>

                <select asp-for="MaDVT"
                        asp-items="ViewBag.MaDVT"
                        class="form-control">
                    <option value="">-- Chọn đơn vị tính --</option>
                </select>

                <span asp-validation-for="MaDVT" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
