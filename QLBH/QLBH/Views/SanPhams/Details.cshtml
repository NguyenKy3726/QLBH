@using Microsoft.AspNetCore.Http
@model QLBH.Models.SanPham
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var role = Context.Session.GetString("Role");
    var isGuest = string.IsNullOrEmpty(role);
    var isCustomer = role == "KhachHang";
    var canManage = Context.Session.GetString("Permission:ADMIN") == "1";
    var categoryName = ViewBag.TenLSP is Dictionary<short, string> categories && categories.TryGetValue(Model.MaLSP, out var category)
        ? category : "Gạo ngon";
    var unitName = ViewBag.TenDVT is Dictionary<byte, string> units && units.TryGetValue(Model.MaDVT, out var unit)
        ? unit : "Sản phẩm";
    var imagePath = string.IsNullOrWhiteSpace(Model.AnhSP) || !(Model.AnhSP.StartsWith("/") || Model.AnhSP.StartsWith("~/") || Model.AnhSP.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        ? Url.Content("~/assets/images/products/tiramisu.webp")
        : Url.Content(Model.AnhSP);
}

<p class="home-eyebrow">WHISKFUL RICE COLLECTION</p>
<section class="product-details">
    <div class="product-details__image">
        <img src="@imagePath" alt="@Model.TenSP" onerror="this.onerror=null;this.src='/assets/images/products/tiramisu.webp'" />
    </div>
    <div class="product-details__info">
        <span class="product-card__tag position-static d-inline-block mb-3">@categoryName</span>
        <h1>@Model.TenSP</h1>
        <p class="product-details__price">@Model.DonGia.ToString("N0")đ <small class="text-muted fs-6 fw-normal">/ @unitName</small></p>
        <p>@(string.IsNullOrWhiteSpace(Model.MoTaCT) ? "Sản phẩm gạo được lựa chọn cho bữa cơm thơm ngon, đủ vị." : Model.MoTaCT)</p>
        <hr />
        <dl class="row">
            <dt class="col-5">Mã sản phẩm</dt><dd class="col-7">@Model.MaSP</dd>
            <dt class="col-5">Loại sản phẩm</dt><dd class="col-7">@categoryName</dd>
            <dt class="col-5">Đơn vị tính</dt><dd class="col-7">@unitName</dd>
        </dl>
        @if (isCustomer)
        {
            <form asp-controller="GioHang" asp-action="Them" method="post" class="product-details__order">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maSP" value="@Model.MaSP" />
                <label for="soLuong" class="form-label">Số lượng</label>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <input id="soLuong" name="soLuong" type="number" value="1" min="1" max="255" class="form-control" style="max-width:120px" />
                    <button type="submit" class="btn btn-primary">Thêm vào giỏ hàng</button>
                </div>
            </form>
        }
        else if (isGuest)
        {
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Đăng nhập để mua</a>
        }
        <div class="mt-4 d-flex flex-wrap gap-3">
            <a asp-action="Index">← Quay lại sản phẩm</a>
            @if (canManage)
            {
                <a asp-action="Edit" asp-route-masp="@Model.MaSP">Sửa sản phẩm</a>
            }
        </div>
    </div>
</section>
