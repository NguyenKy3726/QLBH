@using Microsoft.AspNetCore.Http
@model QLBH.Models.SanPham
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var role = Context.Session.GetString("Role");
    var isGuest = string.IsNullOrEmpty(role);
    var isCustomer = role == "KhachHang";
    var canManage = Context.Session.GetString("Permission:ADMIN") == "1";
}

<h1>Details</h1>

<div>
    <h4>SanPham</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Mã sản phẩm
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaSP)
        </dd>

        <dt class = "col-sm-2">
            Tên sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenSP)
        </dd>
    
        <dt class = "col-sm-2">
            Đơn giá
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DonGia)
        </dd>
    
        <dt class = "col-sm-2">
            Ảnh minh họa
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.AnhSP))
            {
                var imageSource = Model.AnhSP.StartsWith("~/") || Model.AnhSP.StartsWith("/")
                    ? Url.Content(Model.AnhSP)
                    : Url.Action("SanPham", "Images", new { id = Model.MaSP });
                <img src="@imageSource" alt="Ảnh @Model.TenSP" style="max-width:240px;max-height:200px;object-fit:contain" />
                <div>@Model.AnhSP</div>
            }
        </dd>
    
        <dt class = "col-sm-2">
            Mô tả
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MoTaCT)
        </dd>
    
        <dt class = "col-sm-2">
            Loại sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenLSP[Model.MaLSP])
        </dd>
    
        <dt class = "col-sm-2">
            Đơn vị tính
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenDVT[Model.MaDVT])
        </dd>
    </dl>
</div>
@if (isCustomer)
{
<div class="mb-3">
    <form asp-controller="GioHang" asp-action="Them" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="maSP" value="@Model.MaSP" />
        <label for="soLuong" class="form-label">Số lượng</label>
        <input id="soLuong" name="soLuong" type="number" value="1" min="1" max="255" class="form-control" style="max-width:120px" />
        <button type="submit" class="btn btn-primary mt-2">Thêm vào giỏ</button>
    </form>
</div>
}
else if (isGuest)
{
    <p><a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Đăng nhập để mua</a></p>
}
<div>
    @if (canManage)
    {
        <a asp-action="Edit" asp-route-id="@Model?.MaSP">Sửa</a><span> | </span>
    }
    <a asp-action="Index">Quay lại sản phẩm</a>
</div>
