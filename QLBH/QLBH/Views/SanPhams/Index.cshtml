@using Microsoft.AspNetCore.Http
@model IEnumerable<QLBH.Models.SanPham>
@{
    ViewData["Title"] = "Sản phẩm";
    var role = Context.Session.GetString("Role");
    var isCustomer = role == "KhachHang";
    var isEmployee = role == "NhanVien";
    var canCreate = ViewBag.CanCreate is true;
    var canEdit = ViewBag.CanEdit is true;
    var canDelete = ViewBag.CanDelete is true;
    var categories = ViewBag.TenLSP as Dictionary<short, string> ?? new Dictionary<short, string>();
    var selectedCategory = Context.Request.Query["category"].ToString();
    var selectedBudget = Context.Request.Query["budget"].ToString();
    var selectedSearch = Context.Request.Query["q"].ToString();
    var selectedSort = Context.Request.Query["sort"].ToString();
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalProducts = (int)ViewBag.TotalProducts;
    var pageSize = (int)ViewBag.PageSize;
    var firstProduct = totalProducts == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var lastProduct = Math.Min(currentPage * pageSize, totalProducts);
}

    <section class="catalog-heading">
        <p class="home-eyebrow">WHISKFUL RICE COLLECTION</p>
        <h1>Chọn gạo ngon cho bữa cơm nhà</h1>
        <p>"Gạo sạch từ tâm - Trọn vị bữa cơm"</p>
    </section>

    @if (isEmployee && canCreate)
    {
        <div class="mb-4"><a asp-action="Create" class="btn btn-primary">create</a></div>
    }

    <form class="catalog-tools" id="catalog-filter" method="get" asp-controller="SanPhams" asp-action="Index">
        <div>
            <label class="form-label" for="catalog-search">Tìm sản phẩm</label>
            <input class="form-control" id="catalog-search" name="q" value="@selectedSearch" type="search" placeholder="Tên gạo, mô tả..." />
        </div>
        <div>
            <label class="form-label" for="catalog-category">Loại sản phẩm</label>
            <select class="form-select" id="catalog-category" name="category">
                <option value="">Tất cả loại gạo</option>
                @foreach (var category in categories)
                {
                    if (category.Value == selectedCategory)
                    {
                        <option value="@category.Value" selected>@category.Value</option>
                    }
                    else
                    {
                        <option value="@category.Value">@category.Value</option>
                    }
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="catalog-budget">Tầm giá</label>
            <select class="form-select" id="catalog-budget" name="budget">
                <option value="" selected="@(string.IsNullOrEmpty(selectedBudget) ? "selected" : null)">Mọi mức giá</option>
                <option value="0-300000" selected="@(selectedBudget == "0-300000" ? "selected" : null)">Dưới 300.000đ</option>
                <option value="300000-500000" selected="@(selectedBudget == "300000-500000" ? "selected" : null)">300.000đ – 500.000đ</option>
                <option value="500000-1000000" selected="@(selectedBudget == "500000-1000000" ? "selected" : null)">500.000đ – 1.000.000đ</option>
                <option value="1000000-" selected="@(selectedBudget == "1000000-" ? "selected" : null)">Trên 1.000.000đ</option>
            </select>
        </div>
        <div>
            <label class="form-label" for="catalog-sort">Sắp xếp</label>
            <select class="form-select" id="catalog-sort" name="sort">
                <option value="default" selected="@(string.IsNullOrEmpty(selectedSort) || selectedSort == "default" ? "selected" : null)">Mặc định</option>
                <option value="price-asc" selected="@(selectedSort == "price-asc" ? "selected" : null)">Giá thấp đến cao</option>
                <option value="price-desc" selected="@(selectedSort == "price-desc" ? "selected" : null)">Giá cao đến thấp</option>
                <option value="name-asc" selected="@(selectedSort == "name-asc" ? "selected" : null)">Tên A–Z</option>
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Lọc sản phẩm</button>
    </form>

    <p class="text-muted mb-3" id="catalog-count" role="status" aria-live="polite">Hiển thị @(firstProduct)–@lastProduct trên @totalProducts sản phẩm</p>
    <div class="product-grid" id="product-grid">
        @foreach (var item in Model)
        {
            var categoryName = categories.TryGetValue(item.MaLSP, out var name) ? name : "Gạo ngon";
            var imagePath = string.IsNullOrWhiteSpace(item.AnhSP) || !(item.AnhSP.StartsWith("/") || item.AnhSP.StartsWith("~/") || item.AnhSP.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                ? Url.Content("~/assets/images/products/tiramisu.webp")
                : Url.Content(item.AnhSP);
            <article class="product-card" data-name="@item.TenSP" data-category="@categoryName" data-price="@item.DonGia.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                <a class="product-card__image-wrap" asp-action="Details" asp-route-id="@item.MaSP" aria-label="Xem @item.TenSP">
                    <img src="@imagePath" alt="@item.TenSP" loading="lazy" onerror="this.onerror=null;this.src='/assets/images/products/tiramisu.webp'" />
                    <span class="product-card__tag">@categoryName</span>
                </a>
                <div class="product-card__body">
                    <h2 class="product-card__name"><a asp-action="Details" asp-route-id="@item.MaSP">@item.TenSP</a></h2>
                    <p class="product-card__description">@item.MoTaCT</p>
                    <p class="product-card__price">@item.DonGia.ToString("N0")đ</p>
                    <div class="product-card__actions flex-wrap">
                        <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@item.MaSP">Chi tiết</a>
                        @if (isCustomer)
                        {
                            <form asp-controller="GioHang" asp-action="Them" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maSP" value="@item.MaSP" />
                                <input type="hidden" name="soLuong" value="1" />
                                <button type="submit" class="btn btn-primary">Thêm giỏ</button>
                            </form>
                        }
                        @if (isEmployee && canEdit)
                        {
                            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-masp="@item.MaSP">Sửa</a>
                        }
                        @if (isEmployee && canDelete)
                        {
                            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@item.MaSP">Xóa</a>
                        }
                    </div>
                </div>
            </article>
        }
        @if (totalProducts == 0)
        {
            <p class="catalog-empty" id="catalog-empty">Không tìm thấy sản phẩm phù hợp. Hãy thử đổi bộ lọc.</p>
        }
    </div>

@if (totalPages > 1)
{
    <nav class="catalog-pagination" aria-label="Phân trang sản phẩm">
        <p class="catalog-pagination__summary">Trang <strong>@currentPage</strong> / @totalPages</p>
        <ul class="pagination">
            @if (currentPage > 1)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-category="@selectedCategory" asp-route-budget="@selectedBudget" asp-route-q="@selectedSearch" asp-route-sort="@selectedSort" aria-label="Trang trước"><span aria-hidden="true">←</span> Trước</a></li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link" aria-disabled="true"><span aria-hidden="true">←</span> Trước</span></li>
            }
            @for (var number = 1; number <= totalPages; number++)
            {
                <li class="page-item @(number == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@number" asp-route-category="@selectedCategory" asp-route-budget="@selectedBudget" asp-route-q="@selectedSearch" asp-route-sort="@selectedSort" aria-label="Trang @number" aria-current="@(number == currentPage ? "page" : null)">@number</a>
                </li>
            }
            @if (currentPage < totalPages)
            {
                <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-category="@selectedCategory" asp-route-budget="@selectedBudget" asp-route-q="@selectedSearch" asp-route-sort="@selectedSort" aria-label="Trang sau">Sau <span aria-hidden="true">→</span></a></li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link" aria-disabled="true">Sau <span aria-hidden="true">→</span></span></li>
            }
        </ul>
    </nav>
}
