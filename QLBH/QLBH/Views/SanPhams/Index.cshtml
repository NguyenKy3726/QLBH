@using Microsoft.AspNetCore.Http
@model IEnumerable<QLBH.Models.SanPham>
@{
    ViewData["Title"] = "Sản phẩm";
    var role = Context.Session.GetString("Role");
    var isGuest = string.IsNullOrEmpty(role);
    var isCustomer = role == "KhachHang";
    var canManage = Context.Session.GetString("Permission:ADMIN") == "1";
}

<h1>Sản phẩm</h1>

@if (canManage)
{
    <p><a asp-action="Create" class="btn btn-primary">Thêm sản phẩm</a></p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                Mã sản phẩm
            </th>
            <th>
                Tên sản phẩm
            </th>
            <th>
                Đơn giá
            </th>
            <th>
                Ảnh minh họa
            </th>
            <th>
                Mô tả
            </th>
            <th>
                Loại sản phẩm
            </th>
            <th>
                Đơn vị tính
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaSP)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenSP)
            </td>
            <td>
                @Html.DisplayFor(model => item.DonGia)
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.AnhSP))
                {
                    var imageSource = item.AnhSP.StartsWith("~/") || item.AnhSP.StartsWith("/")
                        ? Url.Content(item.AnhSP)
                        : Url.Action("SanPham", "Images", new { id = item.MaSP });
                    <img src="@imageSource" alt="Ảnh @item.TenSP" style="max-width:70px;max-height:70px;object-fit:contain" />
                }
            </td>
            <td>
                @Html.DisplayFor(model => item.MoTaCT)
            </td>
            <td>
                @(ViewBag.TenLSP[item.MaLSP])
            </td>
            <td>
                @(ViewBag.TenDVT[item.MaDVT])
            </td>
            <td>
                @if (isCustomer)
                {
                    <form asp-controller="GioHang" asp-action="Them" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maSP" value="@item.MaSP" />
                        <input type="hidden" name="soLuong" value="1" />
                        <button type="submit" class="btn btn-sm btn-primary">Thêm vào giỏ</button>
                    </form>
                    <br />
                }
                else if (isGuest)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-controller="Account" asp-action="Login">Đăng nhập để mua</a>
                    <br />
                }
                <a asp-action="Details" asp-route-id="@item.MaSP">Chi tiết</a>
                @if (canManage)
                {
                    <span> | </span><a asp-action="Edit" asp-route-masp="@item.MaSP">Sửa</a>
                    <span> | </span><a asp-action="Delete" asp-route-id="@item.MaSP">Xóa</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
