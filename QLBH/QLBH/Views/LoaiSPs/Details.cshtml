@model QLBH.Models.LoaiSP

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>LoaiSP</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Mã loại sản phẩm
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaLSP)
        </dd>
        <dt class = "col-sm-2">
            Tên loại sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenLSP)
        </dd>
        <dt class = "col-sm-2">
            Nhóm sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenNSP[Model.MaNSP])
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaLSP">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
