@model IEnumerable<QLBH.Models.LoaiSP>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Mã loại sản phẩm
            </th>
            <th>
                Tên loại sản phẩm
            </th>
            <th>
                Nhóm sản phẩm
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaLSP)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenLSP)
            </td>
            <td>
                @(ViewBag.TenNSP[item.MaNSP])
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaLSP">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaLSP">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaLSP">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
