@model IEnumerable<QLBH.Models.LoaiSP>

@{
    ViewData["Title"] = "Loại sản phẩm";
}

<h1>Loại sản phẩm</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">create</a>
</p>
<div class="table-responsive crud-table-frame">
<table class="table">
    <thead>
        <tr>
            <th>
                Mã loại sản phẩm
            </th>
            <th>
                Tên loại sản phẩm
            </th>
            <th>
                Nhóm sản phẩm
            </th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaLSP)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenLSP)
            </td>
            <td>
                @(ViewBag.TenNSP[item.MaNSP])
            </td>
            <td class="crud-actions">
                <a asp-action="Edit" asp-route-id="@item.MaLSP" class="crud-action crud-action--edit" title="Edit" aria-label="Edit">Edit</a>
                <a asp-action="Details" asp-route-id="@item.MaLSP" class="crud-action crud-action--details" title="Details" aria-label="Details">Details</a>
                <a asp-action="Delete" asp-route-id="@item.MaLSP" class="crud-action crud-action--delete" title="Delete" aria-label="Delete">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
