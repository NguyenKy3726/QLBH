@model QLBH.Models.LoaiSP

@{
    ViewData["Title"] = "Xóa loại sản phẩm";
}

<h1>Xóa loại sản phẩm</h1>

<h3>Bạn có chắc chắn muốn xóa loại sản phẩm này?</h3>

<div>
    <h4>Loại sản phẩm</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TenLSP)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.TenLSP)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.MaNSP)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaNSP)
        </dd>
    </dl>

    @if (ViewBag.LoiXoa != null)
    {
        <div class="alert alert-danger">
            @ViewBag.LoiXoa
        </div>
    }

    <form asp-action="Delete"
          asp-route-id="@Model.MaLSP"
          method="post">
        <input type="hidden" asp-for="MaLSP" />

        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="Index">Quay lại danh sách</a>
    </form>
</div>