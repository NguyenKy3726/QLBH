@model QLBH.Models.NhaCC

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>NhaCC</h4>
    <hr />
    <dl class="row">

        <dt class="col-sm-2">
            Mã NCC
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaNCC)

        <dt class = "col-sm-2">
            Tên NCC
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenNCC)
        </dd>
   
        <dt class = "col-sm-2">
            Điện thoại
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DienThoai)
        </dd>
    
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>
    
        <dt class = "col-sm-2">
            Địa chỉ
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DiaChi)
        </dd>
    
        <dt class = "col-sm-2">
            Xã/ Phường
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenXP[Model.MaXP])
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaNCC">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
