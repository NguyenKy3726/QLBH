@model IEnumerable<QLBH.Models.NhaCC>

@{
    ViewData["Title"] = "Nhà cung cấp";
}

<h1>Nhà cung cấp</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới</a>
</p>
<div class="table-responsive crud-table-frame">
<table class="table">
    <thead>
        <tr>
            <th>
                Mã NCC
            </th>
            <th>
                Tên NCC
            </th>
            <th>
                Điện thoại
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Xã/ Phường
            </th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaNCC)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenNCC)
            </td>
            <td>
                @Html.DisplayFor(model => item.DienThoai)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.DiaChi)
            </td>
            <td>
                @(ViewBag.TenXP[item.MaXP])
            </td>
            <td class="crud-actions">
                <a asp-action="Edit" asp-route-id="@item.MaNCC" class="crud-action crud-action--edit" title="Sửa" aria-label="Sửa"><span class="crud-action__shape" aria-hidden="true"></span></a>
                <a asp-action="Details" asp-route-id="@item.MaNCC" class="crud-action crud-action--details" title="Chi tiết" aria-label="Chi tiết"><span class="crud-action__shape" aria-hidden="true"></span></a>
                <a asp-action="Delete" asp-route-id="@item.MaNCC" class="crud-action crud-action--delete" title="Xóa" aria-label="Xóa"><span class="crud-action__shape" aria-hidden="true"></span></a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
