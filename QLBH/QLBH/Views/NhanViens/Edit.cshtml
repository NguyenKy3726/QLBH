@model QLBH.Models.NhanVien

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>NhanVien</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaNV" />
            <div class="form-group">
                <label>Mã nhân viên</label>
                <p class="form-control-plaintext">@Model.MaNV</p>
            </div>
            <div class="form-group">
                <label>Họ</label>
                <input asp-for="HoNV" class="form-control" />
                <span asp-validation-for="HoNV" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Tên</label>
                <input asp-for="TenNV" class="form-control" />
                <span asp-validation-for="TenNV" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Điện thoại</label>
                <input asp-for="DienThoai" class="form-control" />
                <span asp-validation-for="DienThoai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input asp-for="TenDN" class="form-control" />
                <span asp-validation-for="TenDN" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="MatKhauMoi" class="control-label">
                    Mật khẩu mới
                </label>

                <input type="password"
                       id="Matkhaumoi"
                       name="Matkhaumoi"
                       class="form-control"
                       maxlength="50"
                       autocomplete="new-password" />

                <small class="text-muted">
                    Bỏ trống nếu không muốn đổi mật khẩu.
                </small>

                @Html.ValidationMessage("MatKhauMoi", "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label>Ảnh đại diện</label>
                <input type="file" id="fileAnh" name="fileAnh" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                <small class="form-text text-muted">Chọn ảnh mới để thay ảnh hiện tại; bỏ trống để giữ ảnh. JPG, PNG hoặc WEBP, tối đa 5 MB.</small>
                <span class="text-danger">@Html.ValidationMessage("fileAnh")</span>
                @if (!string.IsNullOrWhiteSpace(Model.AnhNV))
                {
                    <div class="mt-2"><div>Ảnh hiện tại:</div><img src="@Url.Content(Model.AnhNV)" alt="Ảnh đại diện của @Model.HoNV @Model.TenNV" style="max-width:180px;max-height:180px;border-radius:50%;object-fit:cover;" /></div>
                }
                <img id="previewAnh" alt="Xem trước ảnh mới" style="display:none;max-width:180px;max-height:180px;margin-top:12px;border-radius:50%;object-fit:cover;" />
            </div>
            <div class="form-group">
                <label asp-for="MaPB" class="control-label">
                    Phòng ban
                </label>

                <select asp-for="MaPB"
                        asp-items="ViewBag.MaPB"
                        class="form-control">
                    <option value="">-- Chọn phòng ban --</option>
                </select>

                <span asp-validation-for="MaPB" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('fileAnh')?.addEventListener('change', function (event) {
        const file = event.target.files?.[0];
        const preview = document.getElementById('previewAnh');
        if (!file || !preview) {
            if (preview) { preview.removeAttribute('src'); preview.style.display = 'none'; }
            return;
        }
        preview.src = URL.createObjectURL(file);
        preview.style.display = 'block';
    });
</script>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
