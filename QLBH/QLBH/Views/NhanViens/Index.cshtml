@model IEnumerable<QLBH.Models.NhanVien>

@{
    ViewData["Title"] = "Nhân viên";
}

<h1>Nhân viên</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">create</a>
</p>
<div class="table-responsive crud-table-frame">
<table class="table">
    <thead>
        <tr>
            <th>
                Mã nhân viên
            </th>
            <th>
                Họ
            </th>
            <th>
                Tên
            </th>
            <th>
                Điện thoại
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                Tên đăng nhập
            </th>
            <th>
                Passwork
            </th>
            <th>
                Ảnh đại diện
            </th>
            <th>
                Phòng ban
            </th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaNV)
            </td>
            <td>
                @Html.DisplayFor(model => item.HoNV)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenNV)
            </td>
            <td>
                @Html.DisplayFor(model => item.DienThoai)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenDN)
            </td>
            <td>
                 ...
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.AnhNV))
                {
                    <img src="@Url.Content(item.AnhNV)" alt="Ảnh đại diện của @item.HoNV @item.TenNV" style="width:44px;height:44px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh</span>
                }
            </td>
            <td>
                @(ViewBag.TenPB[item.MaPB])
            </td>
            <td class="crud-actions">
                <a asp-action="Edit" asp-route-id="@item.MaNV" class="crud-action crud-action--edit" title="Edit" aria-label="Edit">Edit</a>
                <a asp-action="Details" asp-route-id="@item.MaNV" class="crud-action crud-action--details" title="Details" aria-label="Details">Details</a>
                <a asp-action="Delete" asp-route-id="@item.MaNV" class="crud-action crud-action--delete" title="Delete" aria-label="Delete">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
