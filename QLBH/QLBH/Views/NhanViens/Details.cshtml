@model QLBH.Models.NhanVien

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>NhanVien</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Mã nhân viên
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaNV)
        </dd>

        <dt class = "col-sm-2">
            Họ
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HoNV)
        </dd>

        <dt class = "col-sm-2">
            Tên
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenNV)
        </dd>

        <dt class = "col-sm-2">
            Điện thoại
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DienThoai)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class = "col-sm-2">
            Tên đăng nhập
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenDN)
        </dd>

        <dt class = "col-sm-2">
            Passwork
        </dt>
        <dd class = "col-sm-10">
            ...
        </dd>

        <dt class = "col-sm-2">
            Ảnh đại diện
        </dt>
        <dd class = "col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.AnhNV))
            {
                var imageSource = Model.AnhNV.StartsWith("~/") || Model.AnhNV.StartsWith("/")
                    ? Url.Content(Model.AnhNV)
                    : Url.Action("NhanVien", "Images", new { id = Model.MaNV });
                <img src="@imageSource" alt="Ảnh @Model.HoNV @Model.TenNV" style="width:120px;height:120px;object-fit:cover;border-radius:50%" />
                <div>@Model.AnhNV</div>
            }
        </dd>

        <dt class = "col-sm-2">
            Phòng ban
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenPB[Model.MaPB])
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaNV">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
