@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Trang chủ";
    var daDangNhap = !string.IsNullOrWhiteSpace(Context.Session.GetString("Username"));
}

<section class="bg-light rounded-4 p-4 p-md-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <p class="text-uppercase text-secondary fw-semibold small mb-2">Hệ thống quản lý bán hàng</p>
            <h1 class="display-5 fw-bold">Chào mừng đến với QLBH</h1>
            <p class="lead text-secondary mb-4">
                Truy cập các chức năng theo nhóm nghiệp vụ và quyền được cấp cho tài khoản của bạn.
            </p>
            @if (daDangNhap)
            {
                <a class="btn btn-primary btn-lg" asp-controller="QuanLy" asp-action="Index">Mở trang quản lý</a>
            }
            else
            {
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            }
        </div>
        <div class="col-lg-4 text-center">
            <span class="display-1" aria-hidden="true">📊</span>
        </div>
    </div>
</section>
