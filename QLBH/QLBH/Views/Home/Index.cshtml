@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Trang chủ";
    var role = Context.Session.GetString("Role");
    var isCustomer = role == "KhachHang";
    var isEmployee = role == "NhanVien";
    var hasAdmin = Context.Session.GetString("Permission:ADMIN") == "1";
    var hasSales = Context.Session.GetString("Permission:SALES") == "1";
    var hasWarehouse = Context.Session.GetString("Permission:WAREHOUSE") == "1";
    var canReadCatalog = hasSales || hasWarehouse;
}

<section class="bg-light rounded-4 p-4 p-md-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            @if (isCustomer)
            {
                <h1 class="display-5 fw-bold">Chào @Context.Session.GetString("DisplayName")</h1>
                <p class="lead">Xem sản phẩm và quản lý giỏ hàng của bạn.</p>
            }
            else if (isEmployee)
            {
                <h1 class="display-5 fw-bold">Trang làm việc QLBH</h1>
                <p class="lead">Các chức năng hiển thị theo quyền được gán cho tài khoản.</p>
            }
            else
            {
                <h1 class="display-5 fw-bold">Chào mừng đến với cửa hàng</h1>
                <p class="lead">Xem danh sách sản phẩm hoặc đăng nhập để sử dụng giỏ hàng.</p>
            }

            <div class="d-flex flex-wrap gap-2 mt-3">
                <a class="btn btn-primary btn-lg" asp-controller="SanPhams" asp-action="Index">Xem sản phẩm</a>
                @if (isCustomer)
                {
                    <a class="btn btn-outline-primary btn-lg" asp-controller="GioHang" asp-action="Index">Mở giỏ hàng</a>
                }
                else if (role == null)
                {
                    <a class="btn btn-outline-primary btn-lg" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                }
            </div>
        </div>
        <div class="col-lg-4 text-center">
            <div class="display-1" aria-hidden="true">🛍️</div>
        </div>
    </div>
</section>

@if (isEmployee)
{
    <section id="role-actions" class="mb-4">
        <h2 class="h4 mb-3">Chức năng theo quyền</h2>
        <div class="d-flex flex-wrap gap-2">
            @if (hasAdmin)
            {
                <a class="btn btn-outline-dark" asp-controller="DonViTinhs" asp-action="Index">Đơn vị tính</a>
                <a class="btn btn-outline-dark" asp-controller="NhomSPs" asp-action="Index">Nhóm sản phẩm</a>
                <a class="btn btn-outline-dark" asp-controller="LoaiSPs" asp-action="Index">Loại sản phẩm</a>
                <a class="btn btn-outline-dark" asp-controller="SanPhams" asp-action="Index">Sản phẩm</a>
                <a class="btn btn-outline-dark" asp-controller="Tinhs" asp-action="Index">Tỉnh</a>
                <a class="btn btn-outline-dark" asp-controller="XaPhuongs" asp-action="Index">Xã/phường</a>
                <a class="btn btn-outline-dark" asp-controller="PhongBans" asp-action="Index">Phòng ban</a>
                <a class="btn btn-outline-dark" asp-controller="NhanViens" asp-action="Index">Nhân viên</a>
                <a class="btn btn-outline-dark" asp-controller="Quyens" asp-action="Index">Quyền</a>
                <a class="btn btn-outline-dark" asp-controller="PhanQuyens" asp-action="Index">Phân quyền</a>
                <a class="btn btn-outline-dark" asp-controller="NhaCCs" asp-action="Index">Nhà cung cấp</a>
                <a class="btn btn-outline-dark" asp-controller="DonMHs" asp-action="Index">Đơn mua hàng</a>
                <a class="btn btn-outline-dark" asp-controller="CTMHs" asp-action="Index">Chi tiết mua hàng</a>
                <a class="btn btn-outline-dark" asp-controller="KhachHangs" asp-action="Index">Khách hàng</a>
                <a class="btn btn-outline-dark" asp-controller="DonBHs" asp-action="Index">Đơn bán hàng</a>
                <a class="btn btn-outline-dark" asp-controller="CTBHs" asp-action="Index">Chi tiết bán hàng</a>
            }
            else
            {
                @if (canReadCatalog)
                {
                    <a class="btn btn-outline-dark" asp-controller="DonViTinhs" asp-action="Index">Đơn vị tính</a>
                    <a class="btn btn-outline-dark" asp-controller="NhomSPs" asp-action="Index">Nhóm sản phẩm</a>
                    <a class="btn btn-outline-dark" asp-controller="LoaiSPs" asp-action="Index">Loại sản phẩm</a>
                    <a class="btn btn-outline-dark" asp-controller="Tinhs" asp-action="Index">Tỉnh</a>
                    <a class="btn btn-outline-dark" asp-controller="XaPhuongs" asp-action="Index">Xã/phường</a>
                }
                @if (hasSales)
                {
                    <a class="btn btn-outline-dark" asp-controller="KhachHangs" asp-action="Index">Khách hàng</a>
                }
                @if (hasSales || hasWarehouse)
                {
                    <a class="btn btn-outline-dark" asp-controller="DonBHs" asp-action="Index">Đơn bán hàng</a>
                    <a class="btn btn-outline-dark" asp-controller="CTBHs" asp-action="Index">Chi tiết bán hàng</a>
                }
                @if (hasWarehouse)
                {
                    <a class="btn btn-outline-dark" asp-controller="NhaCCs" asp-action="Index">Nhà cung cấp</a>
                    <a class="btn btn-outline-dark" asp-controller="DonMHs" asp-action="Index">Đơn mua hàng</a>
                    <a class="btn btn-outline-dark" asp-controller="CTMHs" asp-action="Index">Chi tiết mua hàng</a>
                }
            }
        </div>
    </section>
}
