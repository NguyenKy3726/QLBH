@model QLBH.Models.Tinh

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Tinh</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaTinh" />

            <div class="form-group">
                <label>Mã tỉnh</label>
                <p class="form-control-plaintext">@Model.MaTinh</p>
            </div>
            <div class="form-group">
                <label>Tên tỉnh</label>
                <input asp-for="TenTinh" class="form-control" />
                <span asp-validation-for="TenTinh" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
