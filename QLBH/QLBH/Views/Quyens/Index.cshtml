@model IEnumerable<QLBH.Models.Quyen>

@{
    ViewData["Title"] = "Quyền";
}

<h1>Quyền</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới</a>
</p>
<div class="table-responsive crud-table-frame">
<table class="table">
    <thead>
        <tr>
            <th>
                Mã quyền
            </th>
            <th>
                Tên quyền
            </th>
            <th>
                Mô tả
            </th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaQuyen)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenQuyen)
            </td>
            <td>
                @Html.DisplayFor(model => item.MoTa)
            </td>
            <td class="crud-actions">
                <a asp-action="Edit" asp-route-id="@item.MaQuyen" class="crud-action crud-action--edit" title="Sửa" aria-label="Sửa"><span class="crud-action__shape" aria-hidden="true"></span></a>
                <a asp-action="Details" asp-route-id="@item.MaQuyen" class="crud-action crud-action--details" title="Chi tiết" aria-label="Chi tiết"><span class="crud-action__shape" aria-hidden="true"></span></a>
                <a asp-action="Delete" asp-route-id="@item.MaQuyen" class="crud-action crud-action--delete" title="Xóa" aria-label="Xóa"><span class="crud-action__shape" aria-hidden="true"></span></a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
