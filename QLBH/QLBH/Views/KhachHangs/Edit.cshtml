@model QLBH.Models.KhachHang

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>KhachHang</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaKH" />
            <div class="form-group">
                <label>Ảnh đại diện hiện tại</label>
                @if (!string.IsNullOrWhiteSpace(Model.AnhKH))
                {
                    <div><img src="@Url.Action("KhachHang", "Images", new { id = Model.MaKH })" alt="Ảnh @Model.HoKH @Model.TenKH" style="max-width:150px;max-height:150px;object-fit:cover;border-radius:50%" /></div>
                    <small>@Model.AnhKH</small>
                    <label class="form-check-label"><input type="checkbox" name="removeImage" value="true" /> Xóa ảnh hiện tại</label>
                }
                <label for="fileAnh">Chọn ảnh mới (JPG, PNG, WEBP; tối đa 5 MB)</label>
                <input type="file" id="fileAnh" name="fileAnh" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                @Html.ValidationMessage("fileAnh", "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Mã khách hàng</label>
                <p class="form-control-plaintext">@Model.MaKH</p>
            </div>
            <div class="form-group">
                <label>Họ</label>
                <input asp-for="HoKH" class="form-control" />
                <span asp-validation-for="HoKH" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Tên</label>
                <input asp-for="TenKH" class="form-control" />
                <span asp-validation-for="TenKH" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Điện thoại</label>
                <input asp-for="DienThoai" class="form-control" />
                <span asp-validation-for="DienThoai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Địa chỉ</label>
                <input asp-for="DiaChi" class="form-control" />
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaXP" class="control-label">
                    Xã/phường
                </label>

                <select asp-for="MaXP"
                        asp-items="ViewBag.MaXP"
                        class="form-control">
                    <option value="">-- Chọn xã/phường --</option>
                </select>

                <span asp-validation-for="MaXP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input asp-for="TenDN" class="form-control" />
                <span asp-validation-for="TenDN" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="MatKhauMoi" class="control-label">
                    Mật khẩu mới
                </label>

                <input type="password"
                       id="MatKhauMoi"
                       name="MatKhauMoi"
                       class="form-control"
                       maxlength="50"
                       autocomplete="new-password" />

                <small class="text-muted">
                    Bỏ trống nếu không muốn đổi mật khẩu.
                </small>

                @Html.ValidationMessage("MatKhauMoi", "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
