@model QLBH.Models.KhachHang

@{
    ViewData["Title"] = "Edit";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/profile.css" asp-append-version="true" />
}

<h1>Edit</h1>

<h4>KhachHang</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaKH" />
            <div class="form-group">
                <label>Mã khách hàng</label>
                <p class="form-control-plaintext">@Model.MaKH</p>
            </div>
            <div class="form-group">
                <label>Họ</label>
                <input asp-for="HoKH" class="form-control" />
                <span asp-validation-for="HoKH" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Tên</label>
                <input asp-for="TenKH" class="form-control" />
                <span asp-validation-for="TenKH" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Điện thoại</label>
                <input asp-for="DienThoai" class="form-control" />
                <span asp-validation-for="DienThoai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="profile-upload profile-upload--compact" data-current-avatar="@(string.IsNullOrWhiteSpace(Model.AnhKH) ? "" : Url.Content(Model.AnhKH))">
                <div class="profile-upload__preview">
                    <img id="profile-avatar-preview" src="@(string.IsNullOrWhiteSpace(Model.AnhKH) ? null : Url.Content(Model.AnhKH))"
                         alt="Xem trước ảnh đại diện khách hàng" hidden="@string.IsNullOrWhiteSpace(Model.AnhKH)" />
                    <span id="profile-avatar-placeholder" aria-hidden="true" hidden="@(!string.IsNullOrWhiteSpace(Model.AnhKH))">W</span>
                </div>
                <div class="profile-upload__controls">
                    <label for="profile-avatar-file">Chọn ảnh đại diện</label>
                    <input id="profile-avatar-file" name="fileAnh" type="file"
                           accept=".jpg,.jpeg,.png,.webp" aria-describedby="profile-avatar-help profile-avatar-error" />
                    <p id="profile-avatar-help">Ảnh JPG, PNG hoặc WEBP, tối đa 5 MB. Bỏ trống để giữ ảnh hiện tại; nhấn Save để lưu ảnh mới.</p>
                    <p id="profile-avatar-error" class="field-validation-error" role="status" aria-live="polite"></p>
                    @Html.ValidationMessage("fileAnh", null, new { @class = "field-validation-error" })
                    <button id="profile-avatar-reset" type="button" hidden>Bỏ ảnh vừa chọn</button>
                </div>
            </div>
            <div class="form-group">
                <label>Địa chỉ</label>
                <input asp-for="DiaChi" class="form-control" />
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaXP" class="control-label">
                    Xã/phường
                </label>

                <select asp-for="MaXP"
                        asp-items="ViewBag.MaXP"
                        class="form-control">
                    <option value="">-- Chọn xã/phường --</option>
                </select>

                <span asp-validation-for="MaXP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Tên đăng nhập</label>
                <input asp-for="TenDN" class="form-control" />
                <span asp-validation-for="TenDN" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label for="MatKhauMoi" class="control-label">
                    Mật khẩu mới
                </label>

                <input type="password"
                       id="MatKhauMoi"
                       name="MatKhauMoi"
                       class="form-control"
                       maxlength="50"
                       autocomplete="new-password" />

                <small class="text-muted">
                    Bỏ trống nếu không muốn đổi mật khẩu.
                </small>

                @Html.ValidationMessage("MatKhauMoi", "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
