@model IEnumerable<QLBH.Models.KhachHang>

@{
    ViewData["Title"] = "Khách hàng";
}

<h1>Khách hàng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">create</a>
</p>
<div class="table-responsive crud-table-frame">
<table class="table">
    <thead>
        <tr>
            <th>
                Mã khách hàng
            </th>
            <th>
                Họ
            </th>
            <th>
                Tên
            </th>
            <th>
                Điện thoại
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Xã/ Phường
            </th>
            <th>
                Tên đăng nhập
            </th>
            <th>Ảnh đại diện</th>
            <th>
                Passwork
            </th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaKH)
            </td>
            <td>
                @Html.DisplayFor(model => item.HoKH)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenKH)
            </td>
            <td>
                @Html.DisplayFor(model => item.DienThoai)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.DiaChi)
            </td>
            <td>
                @(ViewBag.TenXP[item.MaXP])
            </td>
            <td>
                @Html.DisplayFor(model => item.TenDN)
            </td>
            <td>
                @if (!string.IsNullOrWhiteSpace(item.AnhKH))
                {
                    <img src="@Url.Content(item.AnhKH)" alt="Ảnh đại diện của @item.HoKH @item.TenKH" style="width:44px;height:44px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    <span class="text-muted">Chưa có ảnh</span>
                }
            </td>
            <td>
                ...
            </td>
            <td class="crud-actions">
                <a asp-action="Edit" asp-route-id="@item.MaKH" class="crud-action crud-action--edit" title="Edit" aria-label="Edit">Edit</a>
                <a asp-action="Details" asp-route-id="@item.MaKH" class="crud-action crud-action--details" title="Details" aria-label="Details">Details</a>
                <a asp-action="Delete" asp-route-id="@item.MaKH" class="crud-action crud-action--delete" title="Delete" aria-label="Delete">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
