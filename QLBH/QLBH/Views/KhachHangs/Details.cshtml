@model QLBH.Models.KhachHang

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>KhachHang</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Mã khách hàng
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaKH)
        </dd>

        <dt class = "col-sm-2">
            Họ
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HoKH)
        </dd>

        <dt class = "col-sm-2">
            Tên
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenKH)
        </dd>

        <dt class = "col-sm-2">
            Điện thoại
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DienThoai)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class = "col-sm-2">
            Địa chỉ
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DiaChi)
        </dd>

        <dt class = "col-sm-2">
            Xã/ Phường
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenXP[Model.MaXP])
        </dd>

        <dt class = "col-sm-2">
            Tên đăng nhập
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenDN)
        </dd>

        <dt class="col-sm-2">Ảnh đại diện</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrWhiteSpace(Model.AnhKH))
            {
                <img src="@Url.Content(Model.AnhKH)" alt="Ảnh đại diện của @Model.HoKH @Model.TenKH" style="width:120px;height:120px;border-radius:50%;object-fit:cover;" />
            }
            else
            {
                <span>Chưa có ảnh đại diện</span>
            }
        </dd>

        <dt class = "col-sm-2">
            Passwork
        </dt>
        <dd class = "col-sm-10">
            ...
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaKH">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
