@model QLBH.Models.TaiKhoanViewModel
@{ ViewData["Title"] = "Thông tin tài khoản"; }
@section Styles {
    <link rel="stylesheet" href="~/css/pages/profile.css" asp-append-version="true" />
}
<section class="profile-page container" aria-labelledby="profile-title">
    <header><p class="profile-eyebrow">HỒ SƠ WHISKFUL</p><h1 id="profile-title">Thông tin tài khoản</h1><p>Cập nhật thông tin liên hệ để chúng mình phục vụ bạn tốt hơn.</p></header>
    @if (TempData["ThongBaoHoSo"] is string message) { <p class="profile-message" role="status">@message</p> }
    <div class="profile-grid">
        <aside class="profile-card profile-identity">
            @if (!string.IsNullOrWhiteSpace(Model.AnhDaiDien))
            {
                <img class="profile-avatar" src="@Url.Content(Model.AnhDaiDien)" alt="Ảnh đại diện của @Model.TenHienThi" />
            }
            else
            {
            <span class="profile-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.TenHienThi) ? "W" : Model.TenHienThi.Trim()[0].ToString().ToUpperInvariant())</span>
            }
            <h2>@Model.TenHienThi</h2><span class="profile-role">@Model.VaiTro</span>
            <dl><dt>Tên đăng nhập</dt><dd>@Model.TenDangNhap</dd></dl>
            @if (Model.VaiTro == "Khách hàng") {
                <a asp-controller="GioHang" asp-action="DonCuaToi">Đơn hàng của tôi →</a>
                <p>Việc cập nhật hồ sơ không thay đổi thông tin của những đơn hàng đã đặt.</p>
            }
            <a asp-controller="Home" asp-action="Index">Về trang chủ →</a>
        </aside>
        <section class="profile-card" aria-labelledby="profile-edit-title">
            <p class="profile-eyebrow">THÔNG TIN CÁ NHÂN</p><h2 id="profile-edit-title">Chỉnh sửa hồ sơ</h2>
            <form asp-action="ThongTin" method="post" enctype="multipart/form-data" class="profile-form">
                <div asp-validation-summary="All" class="profile-errors" role="alert"></div>
                <div class="profile-upload" data-current-avatar="@(string.IsNullOrWhiteSpace(Model.AnhDaiDien) ? "" : Url.Content(Model.AnhDaiDien))">
                    <div class="profile-upload__preview">
                        <img id="profile-avatar-preview" src="@(string.IsNullOrWhiteSpace(Model.AnhDaiDien) ? null : Url.Content(Model.AnhDaiDien))"
                             alt="Xem trước ảnh đại diện" hidden="@string.IsNullOrWhiteSpace(Model.AnhDaiDien)" />
                        <span id="profile-avatar-placeholder" aria-hidden="true" hidden="@(!string.IsNullOrWhiteSpace(Model.AnhDaiDien))">@(string.IsNullOrWhiteSpace(Model.TenHienThi) ? "W" : Model.TenHienThi.Trim()[0].ToString().ToUpperInvariant())</span>
                    </div>
                    <div class="profile-upload__controls">
                        <label for="profile-avatar-file">Chọn ảnh đại diện</label>
                        <input id="profile-avatar-file" name="fileAnh" type="file"
                               accept=".jpg,.jpeg,.png,.webp" aria-describedby="profile-avatar-help profile-avatar-error" />
                        <p id="profile-avatar-help">Ảnh JPG, PNG hoặc WEBP, tối đa 5 MB. Nhấn “Lưu thay đổi” để cập nhật.</p>
                        <p id="profile-avatar-error" class="field-validation-error" role="status" aria-live="polite"></p>
                        @Html.ValidationMessage("fileAnh", null, new { @class = "field-validation-error" })
                        <button id="profile-avatar-reset" type="button" hidden>Bỏ ảnh vừa chọn</button>
                    </div>
                </div>
                <div class="profile-fields">
                    <label><span>Họ và tên đệm *</span><input asp-for="Ho" autocomplete="family-name" maxlength="30" required /><span asp-validation-for="Ho"></span></label>
                    <label><span>Tên *</span><input asp-for="Ten" autocomplete="given-name" maxlength="20" required /><span asp-validation-for="Ten"></span></label>
                    <label><span>Điện thoại</span><input asp-for="DienThoai" type="tel" autocomplete="tel" maxlength="11" /><span asp-validation-for="DienThoai"></span></label>
                    <label><span>Email</span><input asp-for="Email" type="email" autocomplete="email" maxlength="40" /><span asp-validation-for="Email"></span></label>
                    @if (Model.VaiTro == "Khách hàng") {
                        <label class="profile-wide"><span>Địa chỉ</span><textarea asp-for="DiaChi" autocomplete="street-address" rows="3" maxlength="50" required placeholder="Số nhà, tên đường"></textarea><span asp-validation-for="DiaChi"></span></label>
                    }
                </div>
                <div class="profile-actions"><button type="submit">Lưu thay đổi</button><a asp-action="ThongTin">Hủy chỉnh sửa</a></div>
            </form>
        </section>
    </div>
</section>

@section Scripts {
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
