@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-2">Đăng nhập</h1>
                <p class="text-muted mb-4">Dành cho khách hàng và nhân viên.</p>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@(returnUrl)" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label for="TenDN" class="form-label">Tên đăng nhập</label>
                        <input id="TenDN" name="TenDN" class="form-control" autocomplete="username" required />
                    </div>
                    <div class="mb-4">
                        <label for="MatKhau" class="form-label">Mật khẩu</label>
                        <input id="MatKhau" name="MatKhau" type="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
                </form>
            </div>
        </div>
    </div>
</div>
