@model QLBH.Models.CTBH

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>CTBH</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Mã đơn bán hàng
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaDBH)
        </dd>

        <dt class = "col-sm-2">
            Tên sản phẩm
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenSP[Model.MaSP])
        </dd>

        <dt class = "col-sm-2">
            Số lượng bán
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SLB)
        </dd>

        <dt class = "col-sm-2">
            Đơn giá bán
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DGB)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-madbh="@Model?.MaDBH" asp-route-masp="@Model?.MaSP">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
