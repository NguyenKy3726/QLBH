@model IEnumerable<QLBH.Models.CTBH>

@{
    ViewData["Title"] = "Chi tiết bán hàng";
}

<h1>Chi tiết bán hàng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới</a>
</p>
<div class="table-responsive crud-table-frame">
<table class="table">
    <thead>
        <tr>
            <th>
                Mã đơn bán hàng
            </th>
            <th>
                Tên sản phẩm
            </th>
            <th>
                Số lượng bán
            </th>
            <th>
                Số lượng bán
            </th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaDBH)
            </td>
            <td>
                @(ViewBag.TenSP[item.MaSP])
            </td>
            <td>
                @Html.DisplayFor(model => item.SLB)
            </td>
            <td>
                @Html.DisplayFor(model => item.DGB)
            </td>
            <td class="crud-actions">
                <a asp-action="Edit" asp-route-madbh="@item.MaDBH" asp-route-masp="@item.MaSP" class="crud-action crud-action--edit" title="Sửa" aria-label="Sửa"><span class="crud-action__shape" aria-hidden="true"></span></a>
                <a asp-action="Details" asp-route-madbh="@item.MaDBH" asp-route-masp="@item.MaSP" class="crud-action crud-action--details" title="Chi tiết" aria-label="Chi tiết"><span class="crud-action__shape" aria-hidden="true"></span></a>
                <a asp-action="Delete" asp-route-madbh="@item.MaDBH" asp-route-masp="@item.MaSP" class="crud-action crud-action--delete" title="Xóa" aria-label="Xóa"><span class="crud-action__shape" aria-hidden="true"></span></a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
