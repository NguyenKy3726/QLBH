@model QLBH.Models.XaPhuong

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>XaPhuong</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Mã Xã/ Phường
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.MaXP)
        </dd>

        <dt class = "col-sm-2">
            Tên Xã/ Phường
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TenXP)
        </dd>
    
        <dt class = "col-sm-2">
            Mã tỉnh
        </dt>
        <dd class = "col-sm-10">
            @(ViewBag.TenTinh[Model.MaTinh])
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.MaXP">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
