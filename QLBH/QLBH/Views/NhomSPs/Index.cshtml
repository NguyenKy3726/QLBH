@model IEnumerable<QLBH.Models.NhomSP>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Mã nhóm sản phẩm
            </th>
            <th>
                Tên nhóm sản phẩm
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaNSP)
            </td>
            <td>
                @Html.DisplayFor(model => item.TenNSP)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaNSP">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaNSP">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaNSP">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
