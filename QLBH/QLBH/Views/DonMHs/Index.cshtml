@model IEnumerable<QLBH.Models.DonMH>

@{
    ViewData["Title"] = "Đơn mua hàng";
}

<h1>Đơn mua hàng</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">create</a>
</p>
<div class="table-responsive crud-table-frame">
<table class="table">
    <thead>
        <tr>
            <th>
                Mã đơn mua hàng
            </th>
            <th>
                Ngày đặt
            </th>
            <th>
                Ngày giao
            </th>
            <th>
                Mã nhân viên
            </th>
            <th>
                Nhà cung cấp
            </th>
            <th scope="col">Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaDMH)
            </td>
            <td>
                @Html.DisplayFor(model => item.NgayDat)
            </td>
            <td>
                @Html.DisplayFor(model => item.NgayGiao)
            </td>
            <td>
                @item.MaNV - @(ViewBag.TenNV[item.MaNV])
            </td>
            <td>
                @item.MaNCC - @(ViewBag.TenNCC[item.MaNCC])
            </td>
            <td class="crud-actions">
                <a asp-action="Edit" asp-route-id="@item.MaDMH" class="crud-action crud-action--edit" title="Edit" aria-label="Edit">Edit</a>
                <a asp-action="Details" asp-route-id="@item.MaDMH" class="crud-action crud-action--details" title="Details" aria-label="Details">Details</a>
                <a asp-action="Delete" asp-route-id="@item.MaDMH" class="crud-action crud-action--delete" title="Delete" aria-label="Delete">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
