@model IEnumerable<QLBH.Models.DonMH>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Mã đơn mua hàng
            </th>
            <th>
                Ngày đặt
            </th>
            <th>
                Ngày giao
            </th>
            <th>
                Mã nhân viên
            </th>
            <th>
                Nhà cung cấp
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MaDMH)
            </td>
            <td>
                @Html.DisplayFor(model => item.NgayDat)
            </td>
            <td>
                @Html.DisplayFor(model => item.NgayGiao)
            </td>
            <td>
                @item.MaNV - @(ViewBag.TenNV[item.MaNV])
            </td>
            <td>
                @item.MaNCC - @(ViewBag.TenNCC[item.MaNCC])
            </td>
            <td>
                <a asp-action="Edit" asp-route-madmh="@item.MaDMH">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaDMH">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaDMH">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
